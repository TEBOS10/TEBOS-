diff --git a/bame/src/lib/funnel.ts b/bame/src/lib/funnel.ts
new file mode 100644
index 0000000..c42249e
--- /dev/null
+++ b/bame/src/lib/funnel.ts
@@ -0,0 +1,29 @@
+// The enquiry journey's measuring points (TEBOS commercial diagnostic, 26 Oct 2026). Each event names a step and
+// carries only non-personal context (path, step number, section); never a name, email or phone number. The site
+// already uses cookieless Vercel Web Analytics (see the privacy page); custom events need a Vercel plan that
+// includes them, and are silently dropped otherwise — so the leads and diagnostics tables stay the source of truth.
+import { track } from "@vercel/analytics";
+
+export const FUNNEL_EVENTS = [
+  "lead_submitted", // the home page's short form was sent
+  "lead_failed",
+  "intake_viewed", // the diagnostic opened
+  "intake_step", // a section was completed
+  "intake_submitted",
+  "intake_failed",
+  "sprint_viewed", // the sponsor-ready sprint preview opened
+  "sprint_enquiry_submitted",
+] as const;
+export type FunnelEvent = (typeof FUNNEL_EVENTS)[number];
+
+export function funnel(event: FunnelEvent, props: Record<string, string | number> = {}) {
+  try {
+    track(event, props);
+  } catch {
+    // measurement never breaks the journey
+  }
+}
+
+// The short form hands its answers to the diagnostic through this tab's session storage, not the address bar:
+// a name, email or phone number in a URL ends up in browser history, server logs and analytics.
+export const PREFILL_KEY = "bame-intake-prefill";
