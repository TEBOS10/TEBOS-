+// Experiment preview (TEBOS commercial diagnostic, 26 Oct 2026): a bounded sponsor-ready sprint for clubs,
+// academies and events, tested against the open-ended athlete retainers. Not linked from the site and not indexed;
+// it goes live only on the founder's and BAME's approval, and is removed by deleting this folder.
+import Header from "@/components/site/Header";
+import Footer from "@/components/site/Footer";
+import SprintEnquiry from "./SprintEnquiry";
+
+export const metadata = {
+  title: "Sponsor-ready sprint (pilot) — BAME",
+  robots: { index: false, follow: false },
+};
+
+const STEPS = [
+  ["Baseline", "Where your sponsorship stands today: current partners, open conversations, what each is worth, and how enquiries are followed up."],
+  ["One proposition", "One clear reason a local business should back you, with what they get in return, written up as a one-page partner pack."],
+  ["A target list, built with you", "Businesses near you that fit your audience, agreed with you before anyone is contacted."],
+  ["Outreach, tracked", "Approaches made in your name, with your approval, and every reply recorded so nothing is left without a follow-up."],
+  ["A report, not a promise", "At the end: who was approached, who replied, which meetings were booked and what was agreed. Nothing more is claimed."],
+];
+
+export default function SprintPage() {
+  return (
+    <>
+      <Header />
+      <main className="flex-1">
+        <section className="mx-auto max-w-3xl px-5 py-14">
+          <p className="bame-eyebrow">Pilot · for clubs, academies and events</p>
+          <h1 className="mt-3 text-3xl md:text-4xl">Sponsor-ready sprint.</h1>
+          <p className="mt-4 text-[var(--bame-muted)]">
+            A fixed, short piece of work with one aim: get your club or event in front of the right local sponsors, with a
+            proposition worth backing, and track every conversation it starts.
+          </p>
+
+          <ol className="mt-10 grid gap-4">
+            {STEPS.map(([title, desc], i) => (
+              <li key={title} className="rounded-2xl border border-[var(--bame-line)] bg-[var(--bame-panel)] p-5">
+                <p className="bame-eyebrow">{String(i + 1).padStart(2, "0")}</p>
+                <h2 className="mt-1 text-lg">{title}</h2>
+                <p className="mt-2 text-sm text-[var(--bame-muted)]">{desc}</p>
+              </li>
+            ))}
+          </ol>
+
+          <div className="mt-10 grid gap-4 md:grid-cols-2">
+            <div className="rounded-2xl border border-[var(--bame-line)] p-5">
+              <h2 className="text-lg">What you provide</h2>
+              <ul className="mt-3 grid gap-2 text-sm text-[var(--bame-muted)]">
+                <li>Your audience: members, players, attendance or reach, as you know them.</li>
+                <li>Your current sponsors and anything already promised to them.</li>
+                <li>One person who can approve the proposition and each approach.</li>
+                <li>Photos or video you are allowed to use.</li>
+              </ul>
+            </div>
+            <div className="rounded-2xl border border-[var(--bame-line)] p-5">
+              <h2 className="text-lg">What it does not include</h2>
+              <ul className="mt-3 grid gap-2 text-sm text-[var(--bame-muted)]">
+                <li>Guaranteed sponsorship or income. Sponsors decide; the report shows what happened.</li>
+                <li>Contracts with sponsors: those are yours, reviewed by your own adviser.</li>
+                <li>Ongoing social media or production, which are separate services.</li>
+              </ul>
+            </div>
+          </div>
+
+          <p className="mt-8 text-sm text-[var(--bame-muted)]">
+            The price is fixed and agreed in writing before anything starts, after a short call about your club or event.
+          </p>
+
+          <div className="mt-8 rounded-3xl border border-[var(--bame-line)] bg-[var(--bame-panel)] p-6 md:p-8">
+            <SprintEnquiry />
+          </div>
+        </section>
+      </main>
+      <Footer />
+    </>
+  );
+}
