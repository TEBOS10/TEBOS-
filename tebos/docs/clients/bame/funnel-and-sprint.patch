+"use client";
+// The sprint preview's enquiry: the same short lead as the home page, marked with the sprint as its focus so the
+// experiment's enquiries can be counted in the leads table.
+import { useEffect, useState } from "react";
+import { funnel } from "@/lib/funnel";
+
+export const SPRINT_FOCUS = "Sponsor-ready sprint (pilot)";
+
+export default function SprintEnquiry() {
+  const [kind, setKind] = useState<"club" | "event">("club");
+  const [state, setState] = useState<{ kind: "idle" | "sending" | "sent" | "error"; message?: string }>({ kind: "idle" });
+
+  useEffect(() => funnel("sprint_viewed"), []);
+
+  async function onSubmit(e: React.FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    const form = new FormData(e.currentTarget);
+    const payload = {
+      contact_type: kind,
+      full_name: String(form.get("full_name") || "").trim(),
+      email: String(form.get("email") || "").trim(),
+      phone: String(form.get("phone") || "").trim(),
+      sport: String(form.get("sport") || "").trim(),
+      location: String(form.get("location") || "").trim(),
+      primary_focus: SPRINT_FOCUS,
+      goal: String(form.get("goal") || "").trim(),
+      consent: form.get("consent") === "on",
+    };
+    if (!payload.full_name || !payload.email || !payload.consent) {
+      setState({ kind: "error", message: "Please give your name, email and consent." });
+      return;
+    }
+    setState({ kind: "sending" });
+    try {
+      const res = await fetch("/api/lead", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) });
+      const json = await res.json();
+      if (!res.ok || !json.ok) throw new Error(json.error || "Not sent.");
+      funnel("sprint_enquiry_submitted", { contact_type: kind });
+      setState({ kind: "sent" });
+    } catch (err) {
+      setState({ kind: "error", message: err instanceof Error ? err.message : "Not sent." });
+    }
+  }
+
+  if (state.kind === "sent") {
+    return (
+      <div role="status">
+        <p className="bame-eyebrow">Received</p>
+        <p className="mt-2">Thank you. BAME will contact you to arrange the short call. Nothing is agreed until you approve a written scope and price.</p>
+      </div>
+    );
+  }
+
+  const input = "w-full rounded-xl border border-[var(--bame-line)] bg-transparent px-3 py-2 text-sm";
+  return (
+    <form onSubmit={onSubmit} className="grid gap-4">
+      <h2 className="text-lg">Ask about the sprint</h2>
+      <div className="flex gap-2" role="group" aria-label="I run">
+        {(["club", "event"] as const).map((k) => (
+          <button key={k} type="button" aria-pressed={kind === k} onClick={() => setKind(k)}
+            className={`rounded-full border px-4 py-1.5 text-sm ${kind === k ? "border-[var(--bame-accent)] bg-[var(--bame-accent)] text-[#1a1608]" : "border-[var(--bame-line)]"}`}>
+            {k === "club" ? "A club or academy" : "A sports event"}
+          </button>
+        ))}
+      </div>
+      <label className="grid gap-1 text-sm">Your name *<input name="full_name" className={input} required autoComplete="name" /></label>
+      <label className="grid gap-1 text-sm">Email *<input name="email" type="email" className={input} required autoComplete="email" /></label>
+      <label className="grid gap-1 text-sm">Phone<input name="phone" type="tel" className={input} autoComplete="tel" /></label>
+      <label className="grid gap-1 text-sm">Sport<input name="sport" className={input} /></label>
+      <label className="grid gap-1 text-sm">Where you are<input name="location" className={input} /></label>
+      <label className="grid gap-1 text-sm">What would a sponsor need to see from you?<textarea name="goal" rows={3} className={input} /></label>
+      <label className="flex gap-2 text-xs text-[var(--bame-muted)]">
+        <input type="checkbox" name="consent" required />
+        I agree that BAME keeps these details to answer this enquiry. Nothing is agreed or priced at this stage.
+      </label>
+      {state.kind === "error" && <p role="alert" className="text-sm text-red-400">{state.message}</p>}
+      <button className="rounded-full bg-[var(--bame-accent)] px-6 py-3 text-sm font-semibold text-[#1a1608]" disabled={state.kind === "sending"}>
+        {state.kind === "sending" ? "Sending…" : "Ask about the sprint"}
+      </button>
+    </form>
+  );
+}
